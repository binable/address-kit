{
    "name": "binable/address-kit",
    "description": "Symfony bundle for address handling: validation, normalization and permutation of postal addresses.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "address", "validation", "normalization", "zip code", "postal code"],
    "authors": [
        {
            "name": "Tim Lochmüller"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "barbieswimcrew/zip-code-validator": "^4.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/polyfill-intl-normalizer": "^1.31",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/string": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Binable\\AddressKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Binable\\AddressKit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
